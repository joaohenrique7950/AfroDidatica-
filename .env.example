# GEMINI_API_KEY: Chave de API necessária para conexões com os modelos generativos da série Gemini.
# Configure esta chave no seu ambiente de servidor ou arquivo .env local.
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_KEY"

# APP_URL: URL base de host da aplicação correspondente.
# Utilizado para formulações de links autorreferenciais e chamadas de endpoints de API.
APP_URL="SUA_URL_DA_APLICACAO"
